<?php

# Dados do formulário: nome, nota1, nota2
# Precisam ser convertidos para número: nota1 e nota2
# Validação ocorre ANTES do cálculo (notas entre 0 e 10)
# A classificação é avaliada do maior limite para o menor

$nome = "";
$nota1 = "";
$nota2 = "";
$mensagem = "";
$media_formatada = "";
$situacao = "";
$calculado = false;

if ($_SERVER["REQUEST_METHOD"] === "POST") {

    $nome  = trim($_POST["nome"] ?? "");
    $nota1 = trim($_POST["nota1"] ?? "");
    $nota2 = trim($_POST["nota2"] ?? "");

    # Aceita vírgula como separador decimal
    $n1_texto = str_replace(",", ".", $nota1);
    $n2_texto = str_replace(",", ".", $nota2);

    if ($nome === "") {
        $mensagem = "O nome do aluno é obrigatório.";
    } elseif (!is_numeric($n1_texto) || !is_numeric($n2_texto)) {
        $mensagem = "Existe uma nota inválida. Informe valores numéricos.";
    } else {
        $n1 = (float) $n1_texto;
        $n2 = (float) $n2_texto;

        if ($n1 < 0 || $n1 > 10 || $n2 < 0 || $n2 > 10) {
            $mensagem = "Existe uma nota inválida. As notas devem estar entre 0 e 10.";
        } else {
            $media = ($n1 + $n2) / 2;
            $media_formatada = number_format($media, 2, ",", ".");

            if ($media >= 7) {
                $situacao = "APROVADO";
            } elseif ($media >= 4) {
                $situacao = "RECUPERAÇÃO";
            } else {
                $situacao = "REPROVADO";
            }
            $calculado = true;
        }
    }
}

$nome_seguro  = htmlspecialchars($nome, ENT_QUOTES, "UTF-8");
$nota1_seguro = htmlspecialchars($nota1, ENT_QUOTES, "UTF-8");
$nota2_seguro = htmlspecialchars($nota2, ENT_QUOTES, "UTF-8");
?>
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Média</title>
</head>

<body>

    <h1>Calculadora de Média</h1>

    <form method="POST">
        <label for="nome">Nome do aluno:</label>
        <input type="text" id="nome" name="nome" value="<?= $nome_seguro ?>">
        <br><br>

        <label for="nota1">Nota 1:</label>
        <input type="text" id="nota1" name="nota1" value="<?= $nota1_seguro ?>">
        <br><br>

        <label for="nota2">Nota 2:</label>
        <input type="text" id="nota2" name="nota2" value="<?= $nota2_seguro ?>">
        <br><br>

        <button type="submit">Calcular</button>
    </form>

    <?php if ($mensagem !== ""): ?>
        <p><?= $mensagem ?></p>
    <?php endif; ?>

    <?php if ($calculado): ?>
        <h2>Resultado</h2>
        <ul>
            <li>Aluno: <?= $nome_seguro ?></li>
            <li>Média: <?= $media_formatada ?></li>
            <li>Situação: <?= $situacao ?></li>
        </ul>
    <?php endif; ?>

</body>

</html>
