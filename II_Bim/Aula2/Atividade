<?php

# Variáveis da aplicação
$nome = "";
$email = "";
$idade = "";
$cidade = "";
$curso = "";

# Guarda a mensagem (erro ou sucesso) e o tipo dela
$mensagem = "";
$sucesso = false;

# Cursos disponíveis
$cursos = ["Desenvolvimento Web", "Banco de Dados", "Inteligência Artificial"];

# Verifica se o formulário foi enviado via POST
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    # Recebe os dados (os nomes batem com os atributos name do HTML)
    $nome   = $_POST["nome"] ?? "";
    $email  = $_POST["email"] ?? "";
    $idade  = $_POST["idade"] ?? "";
    $cidade = $_POST["cidade"] ?? "";
    $curso  = $_POST["curso"] ?? "";

    # Remove espaços do início e do fim dos campos de texto
    $nome   = trim($nome);
    $email  = trim($email);
    $idade  = trim($idade);
    $cidade = trim($cidade);
    $curso  = trim($curso);

    # Validações, na ordem exigida
    if ($nome === "") {
        $mensagem = "O nome é obrigatório.";
    } elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $mensagem = "Informe um e-mail válido.";
    } elseif ((int) $idade < 16) {
        $mensagem = "A idade mínima é 16 anos.";
    } elseif ($cidade === "") {
        $mensagem = "Informe a cidade.";
    } elseif (!in_array($curso, $cursos, true)) {
        $mensagem = "Selecione um curso.";
    } else {
        $mensagem = "Inscrição realizada com sucesso!";
        $sucesso = true;
    }
}

# Versões seguras para exibir no HTML
$nome_seguro   = htmlspecialchars($nome, ENT_QUOTES, "UTF-8");
$email_seguro  = htmlspecialchars($email, ENT_QUOTES, "UTF-8");
$idade_seguro  = htmlspecialchars($idade, ENT_QUOTES, "UTF-8");
$cidade_seguro = htmlspecialchars($cidade, ENT_QUOTES, "UTF-8");
$curso_seguro  = htmlspecialchars($curso, ENT_QUOTES, "UTF-8");
?>
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscrição — Workshop EventTech</title>
</head>

<body>

    <h1>Inscrição — Workshop EventTech</h1>

    <form method="POST">

        <label for="nome">Nome completo:</label>
        <input type="text" id="nome" name="nome" value="<?= $nome_seguro ?>">

        <br><br>

        <label for="email">E-mail:</label>
        <input type="text" id="email" name="email" value="<?= $email_seguro ?>">

        <br><br>

        <label for="idade">Idade:</label>
        <input type="number" id="idade" name="idade" value="<?= $idade_seguro ?>">

        <br><br>

        <label for="cidade">Cidade:</label>
        <input type="text" id="cidade" name="cidade" value="<?= $cidade_seguro ?>">

        <br><br>

        <label for="curso">Curso desejado:</label>
        <select id="curso" name="curso">
            <option value="">-- Selecione um curso --</option>
            <?php foreach ($cursos as $opcao): ?>
                <option value="<?= htmlspecialchars($opcao, ENT_QUOTES, "UTF-8") ?>"
                    <?= $curso === $opcao ? "selected" : "" ?>>
                    <?= htmlspecialchars($opcao, ENT_QUOTES, "UTF-8") ?>
                </option>
            <?php endforeach; ?>
        </select>

        <br><br>

        <button type="submit">Inscrever-se</button>

    </form>

    <?php if ($mensagem !== ""): ?>
        <p><?= $mensagem ?></p>
    <?php endif; ?>

    <?php if ($sucesso): ?>
        <ul>
            <li>Nome: <?= $nome_seguro ?></li>
            <li>Cidade: <?= $cidade_seguro ?></li>
            <li>Curso: <?= $curso_seguro ?></li>
        </ul>
    <?php endif; ?>

</body>

</html>
